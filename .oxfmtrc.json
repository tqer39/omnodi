{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "artifacts/**",
    "examples/**",
    "src/assets/*.svg",
    "src/assets/manifest.json",
    "docs/screenshots/**",
    "package-lock.json",
    ".codex/hooks.json",
    ".github/workflows/dev-standards.yml",
    ".rulesync/rules/dev-standards.md",
    ".claude/rules/dev-standards.md",
    ".devin/rules/dev-standards.md",
    ".github/instructions/dev-standards.instructions.md",
    ".standards/state.json",
    ".standards/lock.json",
    ".standards/repository.yml",
    ".standards/exceptions.yml",
    ".standards/rules.md",
    "mise.toml"
  ]
}
